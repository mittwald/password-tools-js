{
    "version": "0.0.0-development",
    "license": "MIT",
    "author": "Mittwald CM Service GmbH & Co. KG <opensource@mittwald.de>",
    "description": "Simple password validation and generation by simple and sharable rules.",
    "name": "@mittwald/password-tools-js",
    "packageManager": "pnpm@10.33.0",
    "sideEffects": [
        "./dist/cli.js"
    ],
    "engines": {
        "node": ">=21"
    },
    "repository": "github:mittwald/password-tools-js",
    "bin": {
        "password-tools-js": "./bin/cli.js"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        "./policy": {
            "types": "./dist/Policy.d.ts",
            "require": "./dist/Policy.cjs",
            "node": "./dist/Policy.cjs",
            "default": "./dist/Policy.js"
        },
        "./rules": {
            "types": "./dist/Rule.d.ts",
            "require": "./dist/Rule.cjs",
            "node": "./dist/Rule.cjs",
            "default": "./dist/Rule.js"
        },
        "./generator": {
            "types": "./dist/Generator.d.ts",
            "require": "./dist/Generator.cjs",
            "node": "./dist/Generator.cjs",
            "default": "./dist/Generator.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "require": "./dist/errors.cjs",
            "node": "./dist/errors.cjs",
            "default": "./dist/errors.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "policy": [
                "./dist/Policy.d.ts"
            ],
            "rules": [
                "./dist/Rule.d.ts"
            ],
            "generator": [
                "./dist/Generator.d.ts"
            ],
            "errors": [
                "./dist/errors.d.ts"
            ]
        }
    },
    "scripts": {
        "password-tools-js": "./bin/cli.js",
        "build": "pnpm run jsonSchema:generate && pnpm run validateFunction:generate && pnpm run build:compile",
        "build:compile": "pnpm run build:compile:cli && pnpm run build:compile:lib",
        "build:compile:cli": "pnpm vite build --config vite.config.cli.ts",
        "build:compile:lib": "pnpm vite build",
        "format": "pnpm prettier --write '**/*.{ts,tsx,yaml,yml,json,md,mdx}'",
        "test": "pnpm run test:lint && pnpm run test:vitest",
        "test:vitest": "pnpm vitest --run",
        "test:lint": "pnpm eslint --cache",
        "jsonSchema:generate": "ts-json-schema-generator -t PolicyDeclaration -p ./src/policy/types.ts -o ./src/policy/schema.json && prettier --write src/policy/schema.json",
        "validateFunction:generate": "ts-node ./src/dev/generateValidation.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@types/js-sha1": "^0.6.3",
        "@types/node": "^22.17.2",
        "@types/verror": "^1.10.11",
        "@types/yargs": "^17.0.33",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "execa": "^9.6.0",
        "jiti": "^2.5.1",
        "prettier": "^3.9.6",
        "prettier-plugin-jsdoc": "^1.8.1",
        "rollup-plugin-node-externals": "^8.0.1",
        "strip-ansi": "^7.1.0",
        "ts-json-schema-generator": "2.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.40.0",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@zxcvbn-ts/core": "^4.2.0",
        "@zxcvbn-ts/language-common": "^4.1.3",
        "@zxcvbn-ts/language-de": "^4.1.1",
        "@zxcvbn-ts/language-en": "^4.1.1",
        "ajv": "^8.20.0",
        "axios": "^1.20.0",
        "fs-jetpack": "^5.1.0",
        "ora": "^8.2.0",
        "pretty-error": "^4.0.0",
        "yaml": "^2.9.0",
        "yargs": "^17.7.2"
    }
}
