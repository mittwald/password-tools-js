{
  "$ref": "#/definitions/PolicyDeclaration",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AnyRuleDeclaration": {
      "anyOf": [
        {
          "$ref": "#/definitions/LengthRuleDeclaration"
        },
        {
          "$ref": "#/definitions/CharPoolRuleDeclaration"
        },
        {
          "$ref": "#/definitions/CharRuleDeclaration"
        },
        {
          "$ref": "#/definitions/RegexRuleDeclaration"
        },
        {
          "$ref": "#/definitions/BlocklistRuleDeclaration"
        },
        {
          "$ref": "#/definitions/HibpRuleDeclaration"
        },
        {
          "$ref": "#/definitions/SequenceRuleDeclaration"
        }
      ]
    },
    "BlocklistRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22blocklist%22%2CBlocklistConfig%3E"
    },
    "CharPool": {
      "enum": ["lowercase", "uppercase", "numbers", "special", "nonAscii"],
      "type": "string"
    },
    "CharPoolRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22charPool%22%2CCharPoolConfig%3E"
    },
    "CharRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22char%22%2CCharConfig%3E"
    },
    "ComplexityScore": {
      "enum": [0, 1, 2, 3, 4],
      "type": "number"
    },
    "HibpRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22hibp%22%2CHibpConfig%3E"
    },
    "LengthRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22length%22%2CLengthConfig%3E"
    },
    "OneOfRegexFlags": {
      "enum": ["g", "m", "i", "y", "u", "s", "d"],
      "type": "string"
    },
    "PolicyDeclaration": {
      "additionalProperties": false,
      "properties": {
        "minComplexity": {
          "$ref": "#/definitions/ComplexityScore"
        },
        "rules": {
          "items": {
            "$ref": "#/definitions/AnyRuleDeclaration"
          },
          "type": "array"
        }
      },
      "required": ["rules"],
      "type": "object"
    },
    "RegexRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22regex%22%2CRegexConfig%3E"
    },
    "RuleDeclaration<\"blocklist\",BlocklistConfig>": {
      "additionalProperties": false,
      "properties": {
        "blocklist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "identifier": {
          "type": "string"
        },
        "ruleType": {
          "const": "blocklist",
          "type": "string"
        },
        "substringMatch": {
          "type": "boolean"
        }
      },
      "required": ["blocklist", "ruleType", "substringMatch"],
      "type": "object"
    },
    "RuleDeclaration<\"char\",CharConfig>": {
      "additionalProperties": false,
      "properties": {
        "chars": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "ruleType": {
          "const": "char",
          "type": "string"
        }
      },
      "required": ["chars", "ruleType"],
      "type": "object"
    },
    "RuleDeclaration<\"charPool\",CharPoolConfig>": {
      "additionalProperties": false,
      "properties": {
        "charPools": {
          "items": {
            "$ref": "#/definitions/CharPool"
          },
          "type": "array"
        },
        "identifier": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "ruleType": {
          "const": "charPool",
          "type": "string"
        }
      },
      "required": ["charPools", "ruleType"],
      "type": "object"
    },
    "RuleDeclaration<\"hibp\",HibpConfig>": {
      "additionalProperties": {
        "type": ["string", "boolean"]
      },
      "properties": {
        "identifier": {
          "type": "string"
        },
        "ruleType": {
          "const": "hibp",
          "type": "string"
        }
      },
      "required": ["ruleType"],
      "type": "object"
    },
    "RuleDeclaration<\"length\",LengthConfig>": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "ruleType": {
          "const": "length",
          "type": "string"
        }
      },
      "required": ["ruleType"],
      "type": "object"
    },
    "RuleDeclaration<\"regex\",RegexConfig>": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "items": {
            "$ref": "#/definitions/OneOfRegexFlags"
          },
          "type": "array"
        },
        "identifier": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        },
        "ruleType": {
          "const": "regex",
          "type": "string"
        },
        "translationKey": {
          "type": "string"
        }
      },
      "required": ["pattern", "ruleType"],
      "type": "object"
    },
    "RuleDeclaration<\"sequence\",SequenceConfig>": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "maxLength": {
          "type": "number"
        },
        "ruleType": {
          "const": "sequence",
          "type": "string"
        },
        "sequences": {
          "items": {
            "$ref": "#/definitions/SequenceType"
          },
          "type": "array"
        }
      },
      "required": ["ruleType", "sequences"],
      "type": "object"
    },
    "SequenceRuleDeclaration": {
      "$ref": "#/definitions/RuleDeclaration%3C%22sequence%22%2CSequenceConfig%3E"
    },
    "SequenceType": {
      "enum": ["repeat", "keyboard", "number", "alphabet"],
      "type": "string"
    }
  }
}
